{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/danny/Imágenes/terminal/LadyNagat.webp",
        "width": 43,
        "height": 28,
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[38;5;111m", "\u001b[38;5;110m", "\u001b[38;5;183m", "\u001b[38;5;146m"]
    },
    "modules": [
        "break",
        { "type": "custom", "format": " {$3}[ ∆ SYSTEM ]" },
        { "type": "os",       "key": "  {$2}OS ···········{$1}" },
        { "type": "kernel",   "key": "  {$2}KERNEL ·······{$1}" },
        { "type": "command",  "key": "  {$2}UPTIME ·······{$1}", "text": "uptime -p | cut -d ' ' -f 2-" },
        { "type": "packages", "key": "  {$2}PKGS ·········{$1}" },
        { "type": "shell",    "key": "  {$2}SHELL ········{$1}" },
        "break",
        { "type": "custom",   "format": "{$3}[ ⊟ DESKTOP ]" },
        { "type": "wm",       "key": "  {$2}WM ···········{$1}" },
        { "type": "terminal", "key": "  {$2}TERM ·········{$1}" },
        { "type": "command",  "key": "  {$2}USER ·········{$1}", "text": "echo $USER" },
        "break",
        { "type": "custom",   "format": "{$3}[ ⚙ HARDWARE ]" },
        { "type": "cpu",      "key": "  {$2}CPU ··········{$1}" },
        { "type": "gpu",      "key": "  {$2}GPU ··········{$1}" },
        { "type": "memory",   "key": "  {$2}RAM ··········{$1}" },
        { "type": "display",  "key": "  {$2}DISPLAY ······{$1}", "format": "{width}x{height} @ {refresh-rate}Hz" },
        "break"
    ]   
}
